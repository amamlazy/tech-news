---
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_NAME, asset } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  kind?: 'website' | 'article';
  canonicalPath?: string;
  noindex?: boolean;
  wide?: boolean;
}

const { title, description = SITE_DESCRIPTION, kind = 'website', canonicalPath, noindex = false, wide = false } = Astro.props;
const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} · ${SITE_NAME}`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const rssHref = new URL(asset('rss.xml'), Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (error) {}
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={rssHref} />
    <meta name="theme-color" content="#f4f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131210" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={kind} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={SITE_NAME} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;500;600&family=Shippori+Mincho:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="skip-link" href="#main">本文へスキップ</a>
    <div class="accent-bar" aria-hidden="true"></div>
    <slot name="header" />
    <main id="main" class:list={['shell', { 'shell-wide': wide }]}>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
