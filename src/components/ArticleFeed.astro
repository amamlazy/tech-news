---
import ArticleRow from './ArticleRow.astro';
import { formatDateChip, formatDateLabel, groupByDate, type Article } from '../lib/articles';

interface Props {
  articles: Article[];
  emptyTitle: string;
  emptyBody: string;
}

const { articles, emptyTitle, emptyBody } = Astro.props;
const groups = groupByDate(articles);
const latestDate = groups[0]?.date;
---

{
  groups.length === 0 ? (
    <div class="empty-state">
      <p class="empty-title">{emptyTitle}</p>
      <p class="empty-body">{emptyBody}</p>
    </div>
  ) : (
    <>
      {groups.length > 1 && (
        <nav class="date-jumps" aria-label="日付へ移動">
          <span class="date-jumps-label">日付</span>
          {groups.map((group) => (
            <a
              class="date-jump"
              href={`#date-${group.date}`}
              data-date-categories={[...new Set(group.articles.map((article) => article.data.category))].join(' ')}
            >
              {formatDateChip(group.date, latestDate ?? group.date)}
              <span class="count">{group.articles.length}</span>
            </a>
          ))}
        </nav>
      )}
      {groups.map((group) => (
        <section class="date-group" id={`date-${group.date}`}>
          <h2 class="date-heading">
            <time datetime={group.date}>{formatDateLabel(group.date)}</time>
            <span class="date-count">{group.articles.length}件</span>
          </h2>
          <ul class="article-list">
            {group.articles.map((article) => (
              <ArticleRow article={article} />
            ))}
          </ul>
        </section>
      ))}
    </>
  )
}
