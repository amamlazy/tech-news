---
import { formatTime, type Article } from '../lib/articles';
import { getCategory } from '../lib/article-schema.mjs';
import { href } from '../lib/paths';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const category = getCategory(article.data.category);
const articleHref = href(`/articles/${article.id}/`);
---

<li class="article-card" data-article-category={category.slug}>
  <a class="article-card-link" href={articleHref}>
    <p class="meta">
      <span class="category-label">
        <span class="dot" aria-hidden="true"></span>
        {category.label}
      </span>
      <time datetime={article.data.publishedAt}>{formatTime(article.data.publishedAt)}</time>
    </p>
    <h3 class="article-title">{article.data.title}</h3>
    <p class="summary">{article.data.summary}</p>
    <p class="card-source">{article.data.sourceName}</p>
  </a>
</li>
