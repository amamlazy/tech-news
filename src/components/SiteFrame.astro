---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';

interface Props {
  title: string;
  description?: string;
  kind?: 'website' | 'article';
  canonicalPath?: string;
  noindex?: boolean;
  wide?: boolean;
}

const { wide = false, ...props } = Astro.props;
---

<BaseLayout {...props} wide={wide}>
  <Header slot="header" wide={wide} />
  <slot />
  <Footer slot="footer" wide={wide} />
</BaseLayout>
