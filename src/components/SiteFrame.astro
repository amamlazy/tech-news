---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';

interface Props {
  title: string;
  description?: string;
  kind?: 'website' | 'article';
  canonicalPath?: string;
  noindex?: boolean;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <Header slot="header" />
  <slot />
  <Footer slot="footer" />
</BaseLayout>
