---
import ThemeToggle from './ThemeToggle.astro';
import { SITE_NAME, SITE_TAGLINE, asset, href } from '../lib/paths';

interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const home = href('/');
const weekly = href('/weekly/');
const onWeekly = path === weekly || path === href('/category/weekly/');
---

<header class="site-header">
  <div class:list={['shell site-bar', { 'shell-wide': wide }]}>
    <a class="brand" href={home}>
      <span class="brand-title">{SITE_NAME}</span>
      <span class="brand-tagline">{SITE_TAGLINE}</span>
    </a>
    <nav class="site-nav" aria-label="サイト">
      <a href={home} aria-current={path === home ? 'page' : undefined}>ホーム</a>
      <a href={weekly} aria-current={onWeekly ? 'page' : undefined}>今週のまとめ</a>
      <a href={asset('rss.xml')}>RSS</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
