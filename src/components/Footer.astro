---
import { REPO_URL, SITE_NAME, asset } from '../lib/paths';

interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;
---

<footer class="site-footer">
  <div class:list={['shell', { 'shell-wide': wide }]}>
    <p>Xを開く前に、ここを1ページ。</p>
    <p>
      <a href={REPO_URL}>{SITE_NAME} のリポジトリ</a>
      <span aria-hidden="true"> · </span>
      <a href={asset('rss.xml')}>RSS</a>
    </p>
  </div>
</footer>
